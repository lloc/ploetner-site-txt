{
    "name": "lloc/ploetner-site-txt",
    "description": "llms.txt and security.txt for every site in a WordPress multisite network.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dennis Plötner",
            "homepage": "https://ploetner.dev"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "lloc/composer-i18n-scripts": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.6",
        "roots/wordpress-no-content": "^7.1",
        "squizlabs/php_codesniffer": "^3.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "lloc\\PloetnerSiteTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "lloc\\PloetnerSiteTxt\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "lloc/composer-i18n-scripts": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": "phpunit",
        "qa": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "build": [
            "@composer install --no-dev --prefer-dist --optimize-autoloader",
            "bin/git-release.sh",
            "@composer update --prefer-dist --optimize-autoloader"
        ]
    }
}
